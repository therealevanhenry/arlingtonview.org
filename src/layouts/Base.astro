---
import "../styles/tokens.css";
import "../styles/global.css";
import garamond500 from "@fontsource/eb-garamond/files/eb-garamond-latin-500-normal.woff2?url";
import sourceSans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { stripBase, withBase } from "../lib/paths";
import { getSettings } from "../lib/settings";

interface Common {
  description?: string;
  /** ISO timestamp of the newest content shown; the footer prints it as a New York date. */
  lastUpdated?: string;
}
type Props =
  /** The home page: the `<title>` is the site name alone. */
  | (Common & { home: true; title?: string })
  /** Any other page: `<title>` is `<title> | <site name>`. */
  | (Common & { home?: false; title: string });

const DEFAULT_DESCRIPTION =
  "Arlington View Civic Association (AVCA): meeting dates, minutes, bylaws, and county resources for the Arlington View neighborhood of Arlington, Virginia.";
const { contactEmail, siteName } = await getSettings();

const { title, home = false, description = DEFAULT_DESCRIPTION, lastUpdated } = Astro.props;

const pageTitle = home || title === undefined ? siteName : `${title} | ${siteName}`;
// Canonical keeps the base (the github.io preview lives under one) and always ends in a slash.
const canonical = Astro.site
  ? new URL(withBase(stripBase(Astro.url.pathname)), Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={sourceSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={garamond500} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class="site-main container">
      <slot />
    </main>
    <Footer contactEmail={contactEmail} lastUpdated={lastUpdated} />
  </body>
</html>
