---
import "../styles/tokens.css";
import "../styles/global.css";
import garamond500 from "@fontsource/eb-garamond/files/eb-garamond-latin-500-normal.woff2?url";
import sourceSans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { stripBase, withBase } from "../lib/paths";

interface Props {
  /** Page title. The home page ignores it and uses the organization name alone. */
  title: string;
  description?: string;
  /** ISO timestamp of the newest content shown; the footer prints it as a New York date. */
  lastUpdated?: string;
}

const SITE_NAME = "Arlington View Civic Association";
const DEFAULT_DESCRIPTION =
  "Arlington View Civic Association (AVCA): meeting dates, minutes, bylaws, and county resources for the Arlington View neighborhood of Arlington, Virginia.";
// Task 2 rewires this to the site settings.
const CONTACT_EMAIL = "president@arlingtonview.org";

const { title, description = DEFAULT_DESCRIPTION, lastUpdated } = Astro.props;

const isHome = stripBase(Astro.url.pathname) === "/";
const pageTitle = isHome ? SITE_NAME : `${title} | ${SITE_NAME}`;
// Canonical keeps the base (the github.io preview lives under one) and always ends in a slash.
const canonical = Astro.site
  ? new URL(withBase(stripBase(Astro.url.pathname)), Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={sourceSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={garamond500} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class="site-main container">
      <slot />
    </main>
    <Footer contactEmail={CONTACT_EMAIL} lastUpdated={lastUpdated} />
  </body>
</html>
