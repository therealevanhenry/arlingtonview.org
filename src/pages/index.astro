---
import NextMeeting from "../components/NextMeeting.astro";
import QuickLinks from "../components/QuickLinks.astro";
import RecentFiles from "../components/RecentFiles.astro";
import Base from "../layouts/Base.astro";
import { agendaFor, recentFiles } from "../lib/archive";
import { nextMeeting } from "../lib/calendar";
import { lastUpdated, loadSiteData } from "../lib/data";
import { withBase } from "../lib/paths";

const data = await loadSiteData();
const { settings, now, calendar, rows, folders } = data;
const meeting = calendar.ok ? nextMeeting(calendar.meetings, now) : undefined;
const agendaUrl = meeting ? agendaFor(meeting, rows) : undefined;
const recent = recentFiles([folders.meetings, folders.presentations], 3);
---

<Base title="Home" lastUpdated={lastUpdated(data)}>
  <h1 class="visually-hidden">Arlington View Civic Association</h1>
  <div class="sections">
    <NextMeeting meeting={meeting} settings={settings} agendaUrl={agendaUrl} />
    <section class="stack measure">
      <h2 class="visually-hidden">About the association</h2>
      <p>
        The Arlington View Civic Association (AVCA) is the civic association for the Arlington View
        neighborhood in Arlington, Virginia. Membership is open to homeowners, renters, and nonprofit
        organizations within the neighborhood's boundaries.
      </p>
      <p><a class="button" href={withBase("/join/")}>How to join</a></p>
    </section>
    <QuickLinks />
    <RecentFiles files={recent} />
  </div>
</Base>
