---
import { getEntry, render } from "astro:content";
import Logo from "../../assets/logo.svg";
import BoardTable from "../../components/BoardTable.astro";
import Base from "../../layouts/Base.astro";
import { lastUpdated, loadSiteData } from "../../lib/data";
import { withBase } from "../../lib/paths";
import { getBoard } from "../../lib/settings";

const entry = await getEntry("pages", "about");
if (entry === undefined) throw new Error("src/content/pages/about.md is missing");
const { Content } = await render(entry);

const data = await loadSiteData();
const board = await getBoard();
---

<Base
  title="About"
  description="Who the Arlington View Civic Association is, the neighborhood's boundaries, and the board and block captains."
  lastUpdated={lastUpdated(data)}
>
  <div class="sections">
    <section class="stack">
      <h1>About</h1>
      <!-- Two grid children: the rendered Markdown, then the drawing (after the whole intro on phones, beside it from 56rem). -->
      <div class="about-intro">
        <div class="about-text prose prose-lead">
          <Content />
        </div>
        <div class="about-drawing">
          <Logo class="about-drawing-art" role="img" aria-label="Line drawing of the Gray house, the association's logo" />
        </div>
      </div>
    </section>
    <BoardTable board={board} contactEmail={data.settings.contactEmail} />
    <p class="actions"><a href={withBase("/about/history/")}>History of Arlington View</a></p>
  </div>
</Base>
