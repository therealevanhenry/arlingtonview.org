---
import { getEntry, render } from "astro:content";
import HistoryFolderLink from "../../components/HistoryFolderLink.astro";
import HistoryPhotos from "../../components/HistoryPhotos.astro";
import Base from "../../layouts/Base.astro";
import { lastUpdated, loadSiteData } from "../../lib/data";
import { photosFromModules } from "../../lib/historyPhotos";

const entry = await getEntry("pages", "history");
if (entry === undefined) throw new Error("src/content/pages/history.md is missing");
const { Content } = await render(entry);

const data = await loadSiteData();

// The seven County GIS aerial photographs, oldest first. Imported so Astro optimizes them.
const photos = photosFromModules(
  import.meta.glob<{ default: ImageMetadata }>("../../assets/history/*.png", { eager: true }),
);
---


<Base
  title="History"
  description="The history of Arlington View, formerly Johnson's Hill, with County aerial photographs from 1934 to 1989."
  lastUpdated={lastUpdated(data)}
>
  <div class="sections">
    <section class="stack">
      <h1>History</h1>
      <div class="measure prose prose-lead">
        <Content />
      </div>
    </section>
    <section class="stack" aria-labelledby="photographs">
      <h2 id="photographs">Aerial photographs</h2>
      <HistoryPhotos photos={photos} />
      <HistoryFolderLink folderId={data.settings.drive.history} />
    </section>
  </div>
</Base>
