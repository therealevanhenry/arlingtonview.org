---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/paths";
---

<Base title="Page not found" description="This page does not exist on the Arlington View Civic Association site.">
  <section class="stack">
    <h1>Page not found</h1>
    <p class="measure">That page does not exist, or it has moved. Try one of these instead.</p>
    <p class="actions">
      <a href={withBase("/")}>Home</a>
      <a href={withBase("/meetings/")}>Meetings</a>
      <a href={withBase("/documents/")}>Documents</a>
    </p>
  </section>
</Base>
