---
import FileList from "../components/FileList.astro";
import Base from "../layouts/Base.astro";
import { preferPdfTwins } from "../lib/archive";
import { lastUpdated, loadSiteData } from "../lib/data";
import type { FolderResult } from "../lib/drive";

const data = await loadSiteData();
const { settings, folders } = data;

const currentId = settings.drive.bylawsCurrentFileId.trim();
const currentBylawsUrl = currentId === "" ? undefined : `https://drive.google.com/file/d/${currentId}/view`;
// The current PDF is linked above the list, so it is not repeated in it; Doc/PDF twins collapse to the PDF.
const bylaws: FolderResult = folders.bylaws.ok
  ? { ...folders.bylaws, files: preferPdfTwins(folders.bylaws.files).filter((f) => f.id !== currentId) }
  : folders.bylaws;

// The one list the link row and the sections are both built from. Bylaws is the one special case (its slot).
const sections = [
  { id: "bylaws", title: "Bylaws", folder: "bylaws", group: "path" },
  { id: "minutes", title: "Minutes and agendas", folder: "meetings", group: "path" },
  { id: "presentations", title: "Presentations", folder: "presentations", group: "year" },
  { id: "letters", title: "Official letters", folder: "letters", group: "path" },
  { id: "neighborhood-plan", title: "Neighborhood Plan", folder: "neighborhoodPlan", group: "none" },
] as const;
---

<Base
  title="Documents"
  description="Bylaws, meeting minutes and agendas, presentations, official letters, and the Neighborhood Plan."
  lastUpdated={lastUpdated(data)}
>
  <div class="sections">
    <section class="stack">
      <h1>Documents</h1>
      <nav aria-label="Sections on this page">
        <div class="actions">
          {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        </div>
      </nav>
    </section>
    {
      sections.map((s) => {
        const result = s.id === "bylaws" ? bylaws : folders[s.folder];
        return (
          <FileList result={result} title={s.title} id={s.id} group={s.group}>
            {s.id === "bylaws" && currentBylawsUrl !== undefined && (
              <p>
                <a href={currentBylawsUrl}>Current bylaws (PDF)</a>
              </p>
            )}
          </FileList>
        );
      })
    }
  </div>
</Base>
