---
interface Props {
  folderUrl: string;
  /** Replaces the default sentence, e.g. when a table above it is still populated. */
  label?: string;
}

const { folderUrl, label = "The file list is not available right now." } = Astro.props;
---

<p>
  {label} <a href={folderUrl}>Open folder in Google Drive</a>
</p>
