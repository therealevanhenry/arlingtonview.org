---
import Mark from "../assets/logo-small.svg";
import { formatCalendarDate } from "../lib/time";

interface Props {
  /** Role address shown as the contact link. Never a personal address. */
  contactEmail: string;
  /**
   * ISO timestamp of the newest file in the Drive folders (`lastUpdated` in data.ts). Printed as
   * "Documents updated <date>": it says nothing about the page text, which comes from the repository.
   * Omit it and the line is not rendered.
   */
  lastUpdated?: string;
}

const SOURCE_URL = "https://github.com/therealevanhenry/arlingtonview.org";

const { contactEmail, lastUpdated } = Astro.props;

function formatNewYorkDate(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) {
    throw new Error(`Footer: lastUpdated is not a valid ISO timestamp: "${iso}"`);
  }
  return formatCalendarDate(date);
}

const lastUpdatedText = lastUpdated === undefined ? undefined : formatNewYorkDate(lastUpdated);
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <Mark class="site-footer-mark" width="27" height="28" aria-hidden="true" />
    <ul class="site-footer-list" role="list">
      <li><a class="site-footer-link" href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
      <li><a class="site-footer-link" href={SOURCE_URL}>Site source on GitHub</a></li>
      {
        lastUpdatedText !== undefined && (
          <li>
            Documents updated <time datetime={lastUpdated}>{lastUpdatedText}</time>
          </li>
        )
      }
    </ul>
  </div>
</footer>
