---
import { groupByPath, groupByYear, visibleFiles } from "../lib/archive";
import type { DriveFile, FolderResult } from "../lib/drive";
import { formatFileDate } from "../lib/time";
import FolderFallback from "./FolderFallback.astro";

interface Props {
  result: FolderResult;
  title: string;
  id: string;
  group?: "none" | "year" | "path";
  /** Heading level of the title; sub-headings are one level lower. */
  level?: 2 | 3;
}

const { result, title, id, group = "none", level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const SubHeading = `h${level + 1}` as "h3" | "h4";

type Section = { label: string; files: DriveFile[] };
const sections: Section[] = !result.ok
  ? []
  : group === "year"
    ? groupByYear(result.files).map((g) => ({ label: g.year, files: g.files }))
    : group === "path"
      ? groupByPath(result.files)
      : [{ label: "", files: visibleFiles(result.files) }];
const nonEmpty = sections.filter((s) => s.files.length > 0);

---

<section id={id} class="stack" aria-labelledby={`${id}-title`}>
  <Heading id={`${id}-title`}>{title}</Heading>
  <slot />
  {
    !result.ok ? (
      <FolderFallback folderUrl={result.folderUrl} section={title} />
    ) : (
      <>
        {nonEmpty.length === 0 && <p>Nothing posted yet.</p>}
        {nonEmpty.map((s) => (
          <div class="stack file-group">
            {s.label !== "" && <SubHeading>{s.label}</SubHeading>}
            <ul class="files" role="list">
              {s.files.map((f) => {
                const d = formatFileDate(f);
                return (
                  <li class="file">
                    <a href={f.url}>{f.name}</a>
                    {d && (
                      <span class="file-date">
                        {d.kind === "modified" && "Updated "}
                        <time datetime={d.datetime}>{d.text}</time>
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
        <p>
          <a href={result.folderUrl}>Open folder in Google Drive<span class="visually-hidden">, {title}</span></a>
        </p>
      </>
    )
  }
</section>
