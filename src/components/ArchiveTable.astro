---
import type { ArchiveRow } from "../lib/archive";
import { formatArchiveDate } from "../lib/time";

interface Props {
  rows: ArchiveRow[];
  /**
   * Whether the Minutes & Agendas folder was read. When it was not, a missing agenda or minutes is
   * unknown, not a fact, so the cell says "Not available" instead of "Not posted".
   */
  filesLoaded: boolean;
}

const { rows, filesLoaded } = Astro.props;
const missing = filesLoaded ? "Not posted" : "Not available";
---

{
  rows.length > 0 && (
    <table class="table table-archive" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">Date</th>
          <th role="columnheader" scope="col">Agenda</th>
          <th role="columnheader" scope="col">Minutes</th>
          <th role="columnheader" scope="col">Materials</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {rows.map((r) => {
          // The row's date, read out after "Agenda" and "Minutes" so that no two links in the table share a name.
          const date = formatArchiveDate(r.date, r.approximate);
          return (
          <tr role="row">
            <th role="rowheader" scope="row" data-label="Date">
              <time datetime={r.approximate ? r.date.slice(0, 7) : r.date}>{date}</time>
              {r.approximate && " (month)"}
            </th>
            <td role="cell" data-label="Agenda">
              {r.agenda ? (
                <a href={r.agenda.url}>Agenda<span class="visually-hidden">, {date}</span></a>
              ) : (
                <span class="soft">{missing}</span>
              )}
            </td>
            <td role="cell" data-label="Minutes">
              {r.minutes ? (
                <>
                  <a href={r.minutes.url}>Minutes<span class="visually-hidden">, {date}</span></a>
                  {r.minutesDraft && " (draft)"}
                </>
              ) : (
                <span class="soft">{missing}</span>
              )}
            </td>
            <td role="cell" data-label="Materials" class={r.materials.length === 0 ? "cell-empty" : undefined}>
              {r.materials.length > 0 && (
                <ul class="files" role="list">
                  {r.materials.map((m) => (
                    <li class="file">
                      <a href={m.url}>{m.name}</a>
                    </li>
                  ))}
                </ul>
              )}
            </td>
          </tr>
          );
        })}
      </tbody>
    </table>
  )
}
