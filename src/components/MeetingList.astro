---
import type { ArchiveRow } from "../lib/archive";
import { agendaFor } from "../lib/archive";
import { placeLabel, type Meeting } from "../lib/calendar";
import { formatMeetingMonthDay, formatMeetingTime, formatMeetingWeekday, localDate } from "../lib/time";

interface Props {
  meetings: Meeting[];
  rows: ArchiveRow[];
}

const { meetings, rows } = Astro.props;

// One group per New York calendar year, in the order the meetings arrive (chronological).
const groups: Array<{ year: string; meetings: Meeting[] }> = [];
for (const m of meetings) {
  const year = localDate(m.start).slice(0, 4);
  const last = groups[groups.length - 1];
  if (last?.year === year) last.meetings.push(m);
  else groups.push({ year, meetings: [m] });
}
---

{
  groups.map((g) => (
    <div class="stack">
      <h3>{g.year}</h3>
      <ol class="schedule" role="list">
        {g.meetings.map((m) => {
          const agenda = agendaFor(m, rows);
          return (
            <li class="schedule-item">
              <p class="schedule-date">
                <time datetime={m.start.toISOString()}>
                  {formatMeetingWeekday(m.start)}, {formatMeetingMonthDay(m.start)}
                </time>
              </p>
              <p class="schedule-details">
                <span>{formatMeetingTime(m.start, m.end)}</span>
                <span class="soft">{placeLabel(m)}</span>
                {agenda !== undefined && <a href={agenda}>Agenda</a>}
              </p>
            </li>
          );
        })}
      </ol>
    </div>
  ))
}
