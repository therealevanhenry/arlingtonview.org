---
import type { DriveFile } from "../lib/drive";
import { formatModifiedDate } from "../lib/time";

interface Props {
  files: DriveFile[];
}

const { files } = Astro.props;
---

{
  files.length > 0 && (
    <section class="stack" aria-labelledby="recently-added">
      <h2 id="recently-added">Recently added</h2>
      <ul class="files" role="list">
        {files.map((f) => {
          const d = formatModifiedDate(f);
          return (
            <li class="file">
              <a href={f.url}>{f.name}</a>
              {d && (
                <time class="file-date" datetime={d.datetime}>
                  {d.text}
                </time>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
