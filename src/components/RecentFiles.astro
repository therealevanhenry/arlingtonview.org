---
import type { DriveFile } from "../lib/drive";
import { formatCalendarDate } from "../lib/time";

interface Props {
  files: DriveFile[];
}

const { files } = Astro.props;
---

{
  files.length > 0 && (
    <section class="stack" aria-labelledby="recently-added">
      <h2 id="recently-added">Recently added</h2>
      <ul class="files" role="list">
        {files.map((f) => (
          <li class="file">
            <a href={f.url}>{f.name}</a>
            <time class="file-date" datetime={f.modifiedTime}>
              {formatCalendarDate(new Date(f.modifiedTime))}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )
}
